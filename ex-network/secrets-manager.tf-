# ================================================================================
# Secrets Manager 보안 암호 반환
# ================================================================================ 
output "secret_db_password" {
    # 1
    # value = aws_secretsmanager_secret_version.mysql_password_value.secret_string    # 암호 안보임 (secret password 특성)
    # 2
    value = jsondecode(aws_secretsmanager_secret_version.mysql_password.secret_string)["password"]    # 암호 안보임 (secret password 특성)
    sensitive = true    # 암호 보임
}   

